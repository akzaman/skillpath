# Neon Postgres (pooled connection string from the Vercel Neon integration)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public site URL after deploy (no trailing slash)
BETTER_AUTH_URL=https://skillpath.vercel.app

# Keep email/password sign-in on
VITE_AUTH_ENABLED=true
