# Neon Postgres (pooled connection string from the Vercel Neon integration)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public site URL after deploy (no trailing slash)
BETTER_AUTH_URL=https://skillpath-lac.vercel.app

# Keep email/password sign-in on
VITE_AUTH_ENABLED=true

# Optional: S3-compatible bucket for long lecture uploads (Cloudflare R2 recommended).
# When these are set, teachers can upload MP4s up to 2 GB (browser → bucket, not through Vercel).
# S3_BUCKET=lectures
# S3_REGION=auto
# S3_ENDPOINT=https://ACCOUNTID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
